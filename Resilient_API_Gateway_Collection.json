        },
        {
          "name": "Metrics Index",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gateway_url}}/actuator/metrics",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "actuator",
                "metrics"
              ]
            },
            "description": "List of all available metrics. Pick one and append to URL e.g. /actuator/metrics/resilience4j.circuitbreaker.calls"
          }
        },
        {
          "name": "Specific Metric: CB Calls",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gateway_url}}/actuator/metrics/resilience4j.circuitbreaker.calls",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "actuator",
                "metrics",
                "resilience4j.circuitbreaker.calls"
              ]
            },
            "description": "Counts of successful, failed, slow, and not-permitted calls per breaker."
          }
        }
      ]
    }
  ]
}
